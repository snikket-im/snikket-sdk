{
	"name": "borogove",
	"version": "0.0.1",
	"homepage": "https://borogove.dev",
	"description": "An SDK that makes it easy to build your own custom chat experience",
	"keywords": [
		"chat",
		"xmpp"
	],
	"main": "index.js",
	"type": "module",
	"files": [
		"*.js",
		"*.mjs",
		"*.ts"
	],
	"browser": {
		"./borogove.js": "./borogove-browser.js",
		"./persistence.js": "./persistence-browser.js"
	},
	"exports": {
		".": "./index.js",
		"./sqlite-wasm": "./sqlite-wasm.js"
	},
	"scripts": {
		"test:vitest-browser": "vitest run --config ../vitest.config.mts"
	},
	"author": "",
	"license": "Apache-2.0",
	"dependencies": {
		"@xmpp/client": "^0.14.0",
		"@xmpp/debug": "^0.14.0",
		"@xmpp/sasl-scram-sha-1": "^0.14.0"
	},
	"peerDependenciesMeta": {
		"@sqlite.org/sqlite-wasm": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sqlite.org/sqlite-wasm": "^3.53.0-build1",
		"@vitest/browser": "^5.0.0",
		"@vitest/browser-playwright": "^5.0.0",
		"oxlint": "^1.82.0",
		"oxfmt": "^0.67.0",
		"playwright": "1.60.0",
		"typescript": "^5.4.5",
		"vitest": "^5.0.0"
	}
}
